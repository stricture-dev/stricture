{
  "name": "@stricture-examples/simple-hexagonal",
  "version": "1.0.0",
  "description": "Minimal hexagonal architecture example with Stricture boundary enforcement",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node --esm index.ts",
