{
  "name": "@stricture-examples/nextjs-hexagonal",
  "version": "0.1.0",
  "private": true,
  "description": "Example Next.js app using Hexagonal Architecture with Stricture",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
