    "@stricture/eslint-plugin": "workspace:*",
    "@stricture/typescript-config": "workspace:*",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8",
    "eslint-config-next": "^14.1.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
