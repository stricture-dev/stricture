{
  "name": "@stricture-examples/vertical-slice-express",
  "version": "1.0.0",
  "description": "Vertical Slice Architecture example with Stricture feature isolation enforcement",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node --esm index.ts",
    "start": "node dist/index.js",
    "lint": "eslint \"src/**/*.ts\" \"index.ts\"",
    "type-check": "tsc --noEmit",
    "test": "vitest"
  },
  "keywords": [
    "vertical-slice-architecture",
    "vsa",
    "stricture",
    "feature-slices",
    "example"
  ],
  "author": "Stricture",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.0"
  },
  "devDependencies": {
    "@stricture/core": "workspace:*",
    "@stricture/eslint-plugin": "workspace:*",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "vitest": "^1.2.0"
  }
}
