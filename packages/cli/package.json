{
  "name": "@stricture/cli",
  "version": "0.1.0",
  "description": "Interactive CLI tool for managing Stricture architecture enforcement",
  "keywords": [
    "stricture",
    "cli",
    "architecture",
    "scaffolding",
    "init"
  ],
  "homepage": "https://stricture.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/stricture-dev/stricture.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "stricture": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@stricture/core": "workspace:*",
    "commander": "^11.1.0",
    "inquirer": "^9.2.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.0",
    "picocolors": "^1.0.0"
  },
  "devDependencies": {
    "@stricture/typescript-config": "workspace:*",
    "@stricture/eslint-config": "workspace:*",
    "@types/inquirer": "^9.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0",
    "eslint": "^8.56.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
