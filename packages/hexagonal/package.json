{
  "name": "@stricture/hexagonal",
  "version": "0.1.0",
  "description": "Hexagonal (Ports & Adapters) architecture preset for Stricture",
  "keywords": [
    "stricture",
    "hexagonal",
    "ports-and-adapters",
    "architecture",
    "preset"
  ],
  "homepage": "https://stricture.dev/presets/hexagonal",
  "repository": {
    "type": "git",
    "url": "https://github.com/stricture-dev/stricture.git",
    "directory": "packages/hexagonal"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@stricture/core": "workspace:*"
  },
  "peerDependencies": {
    "@stricture/eslint-plugin": "^0.1.0"
  },
  "devDependencies": {
    "@stricture/typescript-config": "workspace:*",
    "@stricture/eslint-config": "workspace:*",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0",
    "eslint": "^8.56.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
