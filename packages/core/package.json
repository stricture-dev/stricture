{
  "name": "@stricture/core",
  "version": "0.1.0",
  "description": "Core types and utilities for Stricture architecture enforcement",
  "keywords": [
    "stricture",
    "architecture",
    "boundaries",
    "types"
  ],
  "homepage": "https://stricture.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/stricture-dev/stricture.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "micromatch": "^4.0.5"
  },
  "devDependencies": {
    "@stricture/eslint-config": "workspace:*",
    "@stricture/typescript-config": "workspace:*",
    "@types/micromatch": "^4.0.6",
    "@types/node": "^20",
    "eslint": "^8.56.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.13"
  },
  "publishConfig": {
    "access": "public"
  }
}
